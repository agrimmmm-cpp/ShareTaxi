# Copy to .env  (docker compose reads it; the backend reads it when run locally from ./backend)
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Infrastructure (docker compose overrides these for the containers)
DATABASE_URL=sqlite:///./sharetaxi.db
# REDIS_URL=redis://localhost:6379/0

# Maps / routing: offline (built-in road skeleton, no key) | osrm
ROUTING_PROVIDER=offline
# OSRM_URL=https://router.project-osrm.org
# GEOCODER=nominatim        # fall back to OpenStreetMap Nominatim for addresses outside the built-in gazetteer

# Payments: fake | stripe
PAYMENT_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# Push (Expo)
PUSH_ENABLED=false

# Tunables: any nested config value via double underscore
# PRICING__PLATFORM_COMMISSION_RATE=0.13
# MATCHING__MAX_PASSENGER_DETOUR_MIN=25
# MATCHING__WEIGHTS__ROUTE_OVERLAP=0.4

# SENTRY_DSN=
