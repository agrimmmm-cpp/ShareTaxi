{
  "expo": {
    "name": "ShareTaxi",
    "slug": "sharetaxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.sharetaxi.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShareTaxi uses your location to suggest pickup points near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.sharetaxi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0B8F7E"
        }
      ]
    ],
    "scheme": "sharetaxi",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": null
    }
  }
}
